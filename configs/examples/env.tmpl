# 全局 .env 模板示例
# 渲染上下文见 internal/render.Context

COMPOSE_PROJECT_NAME=wpg-{{ .Site.Code }}

NACOS_HOST={{ required "nacos host 必填" .Middleware.Nacos.Host }}
NACOS_PORT={{ .Middleware.Nacos.Port }}
NACOS_NAMESPACE={{ .Middleware.Nacos.Namespace }}
NACOS_USERNAME={{ .Middleware.Nacos.Username }}
NACOS_PASSWORD={{ .Middleware.Nacos.Password }}

MYSQL_HOST={{ required "mysql host 必填" .Middleware.MySQL.Host }}
MYSQL_PORT={{ .Middleware.MySQL.Port }}
MYSQL_USER={{ .Middleware.MySQL.User }}
MYSQL_PASSWORD={{ .Middleware.MySQL.Password }}

REDIS_HOST={{ .Middleware.Redis.Host }}
REDIS_PORT={{ .Middleware.Redis.Port }}
REDIS_PASSWORD={{ .Middleware.Redis.Password }}

KAFKA_HOST={{ .Middleware.Kafka.Host }}
KAFKA_PORT={{ .Middleware.Kafka.Port }}
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://{{ .HostIP }}:{{ .Middleware.Kafka.Port }}

WORKSPACE={{ .Paths.Workspace }}
LOG_PATH={{ .Paths.Logs }}
NGINX_HTML={{ .Paths.NginxHTML }}
APP_VERSION={{ .Version }}
